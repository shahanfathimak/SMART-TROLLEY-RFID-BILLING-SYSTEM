#include <WiFi.h>
#include <WebServer.h>
#include <SPI.h>
#include <MFRC522.h>

// ---------- CHANGE THESE ----------
const char* WIFI_SSID = "GNXS-949a38";
const char* WIFI_PASS = "BC62D2949A38";
const char* UPI_ID    = "BC62D2949A38";
const char* SHOP_NAME = "Smart Trolley";
// ----------------------------------

#define SS_PIN  5
#define RST_PIN 22
#define BUZZER_PIN 4

MFRC522 rfid(SS_PIN, RST_PIN);
WebServer server(80);

struct Item {
  String uid;
  String name;
  int    price;
  bool   inCart;
};

Item items[3] = {
  {"A2 AE C5 1C", "Milk",    30, false},
  {"92 95 DA 1C", "Bread",   40, false},
  {"B7 F5 71 60", "Biscuit", 20, false}
};

unsigned long lastScan = 0;

int getTotal() {
  int t = 0;
  for (int i = 0; i < 3; i++) if (items[i].inCart) t += items[i].price;
  return t;
}

String readUID() {
  String s = "";
  for (byte i = 0; i < rfid.uid.size; i++) {
    if (rfid.uid.uidByte[i] < 0x10) s += "0";
    s += String(rfid.uid.uidByte[i], HEX);
    if (i < rfid.uid.size - 1) s += " ";
  }
  s.toUpperCase();
  return s;
}

void beep(int times, int onMs, int offMs) {
  for (int i = 0; i < times; i++) {
    digitalWrite(BUZZER_PIN, HIGH);
    delay(onMs);
    digitalWrite(BUZZER_PIN, LOW);
    if (i < times - 1) delay(offMs);
  }
}

